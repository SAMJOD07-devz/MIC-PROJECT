// Prisma Schema for OrbitCheck 3D Animated Event Check-In System (Prisma 7)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ORGANIZER
  ATTENDEE
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  year          String?
  role          Role           @default(ATTENDEE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  events        Event[]        @relation("OrganizerEvents")
  checkIns      CheckIn[]      @relation("OrganizerCheckIns")

  @@index([email])
}

model Event {
  id            String         @id @default(uuid())
  organizerId   String
  organizer     User           @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  date          DateTime
  capacity      Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]
  checkIns      CheckIn[]

  @@index([organizerId])
}

model Registration {
  id                 String             @id @default(uuid())
  eventId            String
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendeeId         String
  attendee           User               @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  qrToken            String             @unique
  qrTokenHash        String             @unique
  status             RegistrationStatus @default(REGISTERED)
  registeredAt       DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  checkIn            CheckIn?

  @@unique([eventId, attendeeId]) // Ensures single registration per user per event
  @@index([eventId])
  @@index([attendeeId])
  @@index([qrTokenHash])
}

model CheckIn {
  id                   String       @id @default(uuid())
  eventId              String
  event                Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId       String       @unique // Database UNIQUE constraint enforces max 1 check-in per registration
  registration         Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  scannedByOrganizerId String
  scannedBy            User         @relation("OrganizerCheckIns", fields: [scannedByOrganizerId], references: [id])
  idempotencyKey       String?      @unique // Prevents duplicate offline batch retries
  checkInTime          DateTime     @default(now())
  offlineCapturedAt    DateTime?
  deviceId             String?

  @@index([eventId])
  @@index([checkInTime])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  statusCode     Int
  responseJson   String
  createdAt      DateTime @default(now())

  @@index([idempotencyKey])
}
